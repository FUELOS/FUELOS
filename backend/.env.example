# FuelOS backend ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# `.env` git'e girmez; gerçek değerleri asla bu örnek dosyaya yazmayın.

DATABASE_URL=postgresql+asyncpg://fuelos_user:fuelos_pass@localhost:5432/fuelos_db

# JWT imzalama anahtarı — en az 64 rastgele karakter:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DEBUG=false
FRONTEND_URL=http://localhost:5173

# Veresiye: T.C. kimlik no ve yüklenen belgeleri (imzalı fiş, kimlik fotoğrafı)
# şifreleyen ana anahtar. Production'da SECRET_KEY'den AYRI ve KALICI olmalı:
# değişirse mevcut şifreli T.C. verileri ve belgeler okunamaz, T.C. eşleştirmeleri bozulur.
# Boş bırakılırsa SECRET_KEY'den türetilir (yalnızca geliştirme için).
PII_ENCRYPTION_KEY=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# Şifre sıfırlama e-postası
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Midnight kaynak tasdiki için istasyon UUID -> base64 Ed25519 public PEM (JSON)
ZK_SOURCE_PUBLIC_KEYS_JSON={}
ZK_MANAGER_PUBLIC_KEYS_JSON={}
